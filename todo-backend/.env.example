# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file to git.

# Port the server will run on
PORT=5000

# Your MongoDB connection string.
# For local MongoDB: mongodb://127.0.0.1:27017/todoapp
# For MongoDB Atlas (cloud): mongodb+srv://<user>:<password>@cluster.mongodb.net/todoapp
MONGO_URI=mongodb://127.0.0.1:27017/todoapp

# Secret key used to sign JWT tokens. Use a long random string in production.
JWT_SECRET=replace_this_with_a_long_random_secret_string
